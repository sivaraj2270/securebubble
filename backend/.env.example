# SecureBubble AI — Backend Environment Configuration
# Place your real credentials here on your local server.
# NEVER commit this file or expose these keys in client APKs.

VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY_HERE
GOOGLE_WEB_RISK_API_KEY=YOUR_GOOGLE_WEB_RISK_API_KEY_HERE

# Technitium DNS Server Configuration (Local Server 15.5 Integration)
TECHNITIUM_SERVER_URL=http://127.0.0.1:5380
TECHNITIUM_API_TOKEN=
TECHNITIUM_ADMIN_USER=admin
TECHNITIUM_ADMIN_PASSWORD=
TECHNITIUM_AUTO_BLOCK_THRESHOLD=85
TECHNITIUM_TIMEOUT_SECONDS=5.0

DATABASE_URL=sqlite:///./securebubble.db
JWT_SECRET=securebubble-threat-engine-jwt-secret-key-replace-in-prod
ADMIN_DEFAULT_EMAIL=admin@securebubble.ai
